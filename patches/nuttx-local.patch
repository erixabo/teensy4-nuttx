   UNUSED(ret);
+#ifdef CONFIG_SPI_DRIVER
+#  ifdef CONFIG_IMXRT_LPSPI3
+  {
+    struct spi_dev_s *spi = imxrt_lpspibus_initialize(3);
+    if (spi == NULL)
+      {
+        syslog(LOG_ERR, "ERROR: Failed to initialize LPSPI3\n");
+      }
+    else
+      {
+        ret = spi_register(spi, 3);
+        if (ret < 0)
+          {
+            syslog(LOG_ERR, "ERROR: Failed to register LPSPI3: %d\n", ret);
+          }
+      }
+  }
+#  endif
+#endif
   return OK;
 }
