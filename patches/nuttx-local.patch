diff --git a/boards/arm/imxrt/teensy-4.x/src/imxrt_bringup.c b/boards/arm/imxrt/teensy-4.x/src/imxrt_bringup.c
index 53fefa8a..81e83b8d 100644
--- a/boards/arm/imxrt/teensy-4.x/src/imxrt_bringup.c
+++ b/boards/arm/imxrt/teensy-4.x/src/imxrt_bringup.c
@@ -27,11 +27,14 @@
 #include <nuttx/config.h>
 
 #include <sys/types.h>
+#include <sys/stat.h>
 #include <nuttx/debug.h>
 
 #include <syslog.h>
 #include <nuttx/fs/fs.h>
 #include <nuttx/i2c/i2c_master.h>
+#include <nuttx/spi/spi.h>
+#include <nuttx/spi/spi_transfer.h>
 #include <imxrt_lpi2c.h>
 #include <imxrt_lpspi.h>
 #include <nuttx/input/buttons.h>
@@ -149,6 +152,17 @@ int imxrt_bringup(void)
   /* Initialize SDHC-base MMC/SD card support */
 
   nsh_sdmmc_initialize();
+
+#  if defined(CONFIG_TEENSY_41)
+  /* Mount the Teensy 4.1 built-in microSD card for NSH at boot. */
+
+  mkdir("/mnt", 0777);
+  ret = nx_mount("/dev/mmcsd0", "/mnt", "vfat", 0, NULL);
+  if (ret < 0)
+    {
+      syslog(LOG_ERR, "ERROR: Failed to mount microSD at /mnt: %d\n", ret);
+    }
+#  endif
 #endif
 
 #if defined(CONFIG_IMXRT_ENET) && defined(CONFIG_NETDEV_LATEINIT)
@@ -214,5 +228,24 @@ int imxrt_bringup(void)
