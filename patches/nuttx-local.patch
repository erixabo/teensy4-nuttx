diff --git a/drivers/net/telnet.c b/drivers/net/telnet.c
index d227117f..ad469759 100644
--- a/drivers/net/telnet.c
+++ b/drivers/net/telnet.c
@@ -123,6 +123,8 @@ struct telnet_dev_s
   uint8_t           td_minor;     /* Minor device number */
   bool              td_sb_iac;    /* Saw IAC within sub-negotiation payload */
   bool              td_txcr;      /* Last byte sent was a CR */
+  bool              td_sga;       /* Server suppress-go-ahead negotiated */
+  bool              td_sga_pending; /* Server SGA offer awaits client reply */
   uint16_t          td_offset;    /* Offset to the valid, pending bytes in the rxbuffer */
   uint16_t          td_pending;   /* Number of valid, pending bytes in the rxbuffer */
 #ifdef CONFIG_TELNET_SUPPORT_NAWS
@@ -408,12 +410,19 @@ static ssize_t telnet_receive(FAR struct telnet_dev_s *priv,
               {
                 telnet_sendopt(priv, TELNET_DO, ch);
               }
-
-            /* Reply with a DON'T */
-
             else
 #endif
+            if (ch == TELNET_SGA && (priv->td_lflag & ECHO) == 0)
+              {
+                /* Accept character-mode SGA only while the application
+                 * has requested raw input. */
+
+                telnet_sendopt(priv, TELNET_DO, ch);
+              }
+            else
               {
+                /* Reply with a DON'T */
+
                 telnet_sendopt(priv, TELNET_DONT, ch);
                 ninfo("Suppress: 0x%02X (%d)\n", ch, ch);
               }
@@ -430,12 +439,26 @@ static ssize_t telnet_receive(FAR struct telnet_dev_s *priv,
 
             if (ch == TELNET_SGA)
               {
-                /* Reply with a WONT, that means we will not work in
-                 * character mode and stay in line mode,
-                 * it's OK for modern rich featured telnet clients.
-                 */
+                /* Accept character mode only when the application has
+                 * disabled local echo.  If we already offered SGA, DO is
+                 * its acknowledgement and needs no duplicate WILL. */
 
-                telnet_sendopt(priv, TELNET_WONT, ch);
+                if ((priv->td_lflag & ECHO) != 0)
+                  {
+                    telnet_sendopt(priv, TELNET_WONT, ch);
+                    priv->td_sga = false;
+                    priv->td_sga_pending = false;
+                  }
+                else
+                  {
+                    if (!priv->td_sga_pending && !priv->td_sga)
+                      {
+                        telnet_sendopt(priv, TELNET_WILL, ch);
+                      }
+
+                    priv->td_sga = true;
+                    priv->td_sga_pending = false;
+                  }
               }
             else if ((priv->td_lflag & ECHO) != 0 && ch == TELNET_ECHO)
               {
@@ -453,7 +476,21 @@ static ssize_t telnet_receive(FAR struct telnet_dev_s *priv,
 
             /* Reply with a WONT */
 
-            telnet_sendopt(priv, TELNET_WONT, ch);
+            if (ch == TELNET_SGA)
+              {
+                if (priv->td_sga || priv->td_sga_pending)
+                  {
+                    telnet_sendopt(priv, TELNET_WONT, ch);
+                  }
+
+                priv->td_sga = false;
+                priv->td_sga_pending = false;
+              }
+            else
+              {
+                telnet_sendopt(priv, TELNET_WONT, ch);
+              }
+
             priv->td_state = STATE_NORMAL;
             break;
 
@@ -1241,6 +1278,13 @@ static int telnet_ioctl(FAR struct file *filep, int cmd, unsigned long arg)
                */
 
               telnet_sendopt(priv, TELNET_WONT, TELNET_ECHO);
+
+              if (priv->td_sga || priv->td_sga_pending)
+                {
+                  telnet_sendopt(priv, TELNET_WONT, TELNET_SGA);
+                  priv->td_sga = false;
+                  priv->td_sga_pending = false;
+                }
             }
           else
             {
@@ -1249,6 +1293,12 @@ static int telnet_ioctl(FAR struct file *filep, int cmd, unsigned long arg)
                */
 
               telnet_sendopt(priv, TELNET_WILL, TELNET_ECHO);
+
+              if (!priv->td_sga && !priv->td_sga_pending)
+                {
+                  telnet_sendopt(priv, TELNET_WILL, TELNET_SGA);
+                  priv->td_sga_pending = true;
+                }
             }
         }
         break;
diff --git a/drivers/usbdev/cdcacm.c b/drivers/usbdev/cdcacm.c
index 87671cf0..51e745a2 100644
--- a/drivers/usbdev/cdcacm.c
+++ b/drivers/usbdev/cdcacm.c
@@ -1854,6 +1854,24 @@ static int cdcacm_setup(FAR struct usbdevclass_driver_s *driver,
                   {
                     memcpy(&priv->linecoding,
                            dataout, SIZEOF_CDC_LINECODING);
+
+#if defined(CONFIG_TEENSY_41)
+                    /* The PJRC Teensy Loader asks the running firmware to
+                     * enter HalfKay by setting the CDC baud rate to 134.
+                     * Teensyduino handles this with BKPT #251.  Do the same
+                     * here so the standard loader can reflash NuttX without
+                     * requiring the physical Program button each time.
+                     */
+
+                    if (dataout[0] == 134 && dataout[1] == 0 &&
+                        dataout[2] == 0 && dataout[3] == 0)
+                      {
+                        asm volatile("bkpt #251");
+                        for (;;)
+                          {
+                          }
+                      }
+#endif
                   }
 
                 /* Respond with a zero length packet */
