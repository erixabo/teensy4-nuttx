diff --git a/nshlib/nsh_init.c b/nshlib/nsh_init.c
index 49c1488..0e24c8a 100644
--- a/nshlib/nsh_init.c
+++ b/nshlib/nsh_init.c
@@ -164,18 +164,6 @@ void nsh_initialize(void)
   nsh_release(&pstate->cn_vtbl);
 #endif
 
-#if defined(CONFIG_NSH_TELNET) && !defined(CONFIG_NSH_DISABLE_TELNETSTART) && \
-  !defined(CONFIG_NETINIT_NETLOCAL)
-  /* If the Telnet console is selected as a front-end, then start the
-   * Telnet daemon UNLESS network initialization is deferred via
-   * CONFIG_NETINIT_NETLOCAL.  In that case, the telnet daemon must be
-   * started manually with the telnetd command after the network has
-   * been initialized
-   */
-
-  nsh_telnetstart(AF_UNSPEC);
-#endif
-
 #if defined(CONFIG_NSH_DROPBEAR) && \
     !defined(CONFIG_NSH_DISABLE_DROPBEARSTART) && \
     !defined(CONFIG_NETINIT_NETLOCAL)
diff --git a/nshlib/nsh_usbconsole.c b/nshlib/nsh_usbconsole.c
index 74f8a47..9336f96 100644
--- a/nshlib/nsh_usbconsole.c
+++ b/nshlib/nsh_usbconsole.c
@@ -32,6 +32,7 @@
 #include <unistd.h>
 #include <fcntl.h>
 #include <assert.h>
+#include <netinet/in.h>
 #include <nuttx/debug.h>
 
 #ifdef CONFIG_CDCACM
@@ -46,6 +47,9 @@
 #include "nsh_console.h"
 
 #include "netutils/netinit.h"
+#if defined(CONFIG_NSH_TELNET) && !defined(CONFIG_NSH_DISABLESCRIPT)
+#  include "netutils/netlib.h"
+#endif
 
 #ifdef HAVE_USB_CONSOLE
 
@@ -283,10 +287,50 @@ int nsh_consolemain(int argc, FAR char *argv[])
   DEBUGASSERT(ret == OK);
 #endif
 
-  /* Configure to use /dev/null if we do not have a valid console. */
+  /* Use /dev/null while no USB console is connected.  Run the optional
+   * removable startup script now, after the console state is initialized
+   * but before waiting for a USB host. */
 
-#ifndef CONFIG_DEV_CONSOLE
   nsh_nullstdio();
+
+#ifndef CONFIG_NSH_DISABLESCRIPT
+  {
+    FAR struct console_stdio_s *autorun;
+#ifdef CONFIG_NSH_TELNET
+    struct in_addr address;
+    int attempt;
+
+    /* DHCP runs asynchronously; if Telnet is enabled, give it up to ten
+     * seconds to assign an address before the startup script launches
+     * network services.
+     */
+
+    for (attempt = 0; attempt < 10; attempt++)
+      {
+        address.s_addr = 0;
+        if (netlib_get_ipv4addr("eth0", &address) == 0 &&
+            address.s_addr != 0)
+          {
+            break;
+          }
+
+        sleep(1);
+      }
+
+#endif
+
+    /* The SD card is mounted during board bring-up, before nsh_main starts.
+     * Hand the startup file straight to NSH, like its interactive source
+     * command.  A missing file is reported by NSH itself.
+     */
+
+    autorun = nsh_newconsole(false);
+    if (autorun != NULL)
+      {
+        nsh_parse(&autorun->cn_vtbl, "source /mnt/autorun.nsh");
+        nsh_release(&autorun->cn_vtbl);
+      }
+  }
 #endif
 
   /* Now loop, executing creating a session for each USB connection */
